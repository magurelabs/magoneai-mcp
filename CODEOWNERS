# Review is required on these paths. Everything here is either a security
# boundary or a contract that other code depends on being stable.

# The framework. Every connector inherits whatever changes here.
/src/magone_mcp_core/        @cyproto

# The gates themselves. A change that weakens a gate should be at least as
# visible as the thing the gate exists to catch.
/scripts/                    @cyproto
/.github/workflows/          @cyproto
/.github/dependabot.yml      @cyproto

# The golden baseline is the tool contract. A diff here changes what live
# agents are told they may pass.
/tests/golden/               @cyproto

# Licensing, disclosure and how the project is run.
/LICENSE                     @cyproto
/NOTICE                      @cyproto
/SECURITY.md                 @cyproto
/GOVERNANCE.md               @cyproto
/MAINTAINERS.md              @cyproto
/CODEOWNERS                  @cyproto
